QWidget {
    background-color: #111418;
    color: #E6E8EB;
    font-family: "Segoe UI";
    font-size: 10.5pt;
}

QMenuBar {
    background-color: #171B21;
    color: #E6E8EB;
    padding: 6px;
}

QMenuBar::item:selected {
    background-color: #26303A;
}

QMenu {
    background-color: #171B21;
    color: #E6E8EB;
    border: 1px solid #2B3440;
}

QMenu::item:selected {
    background-color: #2B3948;
}

QLabel#LandingTitle {
    font-size: 38pt;
    font-weight: 700;
    color: #FFFFFF;
}

QLabel#LandingSubtitle {
    font-size: 14pt;
    color: #AAB4C0;
}

QLabel#PanelTitle {
    font-size: 12pt;
    font-weight: 700;
    color: #FFFFFF;
    padding: 4px;
}

QFrame#ProjectTile {
    background-color: #1B222B;
    border: 1px solid #344052;
    border-radius: 18px;
}

QFrame#ProjectTile:hover {
    background-color: #222C38;
    border: 1px solid #5C7593;
}

QLabel#TileTitle {
    font-size: 18pt;
    font-weight: 700;
    color: #FFFFFF;
}

QLabel#TileSubtitle {
    font-size: 10.5pt;
    color: #B5C0CC;
}

QTextEdit,
QTreeWidget,
QTabWidget::pane {
    background-color: #171B21;
    border: 1px solid #2B3440;
    color: #E6E8EB;
}

QTabBar::tab {
    background-color: #202733;
    color: #D6DCE3;
    padding: 8px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #2B3948;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #202733;
    color: #E6E8EB;
}

QSplitter::handle {
    background-color: #2B3440;
}